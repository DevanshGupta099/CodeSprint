# ==============================================================================
# VERITAS SUPPLY - FRONTEND COMMAND CENTER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Backend API Endpoint URL
# Use http://localhost:5000 for Node.js Express backend
# Use http://localhost:8000 for Python FastAPI intelligence engine
NEXT_PUBLIC_API_URL=http://localhost:5000

# Default Organization UUID (Veritas Motors Corp)
NEXT_PUBLIC_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Telemetry Polling Interval in milliseconds (3-5 seconds recommended)
NEXT_PUBLIC_POLL_INTERVAL_MS=3000

# WebGL Canvas Shader Effects & HUD Diagnostics
NEXT_PUBLIC_ENABLE_WEBGL=true

# AI Engine API Keys
# GEMINI_API_KEY=AQ...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=9ZOI...
# OPENROUTER_API_KEY=sk-or-...
# CEREBRAS_API_KEY=csk-...


