# ==============================================================================
# VERITAS SUPPLY - BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Node.js Express Server Configuration
PORT=5000
NODE_ENV=development

# Python FastAPI Intelligence Engine Configuration
PYTHON_PORT=8000
PYTHON_HOST=0.0.0.0

# Database Configuration (PostgreSQL 14+ / Supabase / Neon)
# Local example: postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL=postgresql://postgres:root@localhost:5432/veritassupply

# Default Organization UUID (Veritas Motors Corp - Tier 0)
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Optional AI / LLM Structured Reasoning Keys
# Note: Deterministic fallbacks are hardcoded for all agent workflows.
# Keys are optional and only needed if invoking live external LLMs.
# GEMINI_API_KEY=AIzaSy...
# GOOGLE_API_KEY=AIzaSy...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
