# ==============================================================================
# VERITAS SUPPLY - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to backend/.env and frontend/.env.local respectively.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
# Node.js Server Port
PORT=5000
NODE_ENV=development

# Python FastAPI Server Port
PYTHON_PORT=8000
PYTHON_HOST=0.0.0.0

# PostgreSQL 14+ Relational Connection String
# Local PostgreSQL: postgresql://<username>:<password>@localhost:5432/<dbname>
DATABASE_URL=postgresql://postgres:root@localhost:5432/veritassupply

# Default Enterprise Organization UUID (Veritas Motors Corp - Tier 0)
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# External AI Keys (Deterministic offline fallback fixtures remain active if omitted)
# GEMINI_API_KEY=AQ...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=9ZOI...



# ------------------------------------------------------------------------------
# 2. FRONTEND COMMAND CENTER CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------
# Target API Server (Port 5000 for Node.js / Port 8000 for Python FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_POLL_INTERVAL_MS=3000
NEXT_PUBLIC_ENABLE_WEBGL=true
